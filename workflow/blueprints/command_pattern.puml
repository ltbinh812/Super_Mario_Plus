@startuml command_pattern
' Super Mario Plus - the two independent Command pipelines
' Verified against the source tree at commit b378acb.
' Matches: include/command/

title Command Pattern — two separate pipelines

skinparam classAttributeIconSize 0

package "Pipeline 1 — screen transitions" {
  interface IGameCommand {
    + {abstract} Execute(StateManager&)
  }
  class PushStateCommand {
    - unique_ptr<GameState> state
    + Execute(StateManager&)
  }
  class PopStateCommand {
    + Execute(StateManager&)
  }
  class ChangeStateCommand {
    - unique_ptr<GameState> state
    + Execute(StateManager&)
  }
  class GameState_ as "GameState\n(client)" {
    - vector<unique_ptr<IGameCommand>> stateCommandQueue
    + PushStateCommand(unique_ptr<IGameCommand>)
    + ConsumeCommands()
  }
  class StateManager_ as "StateManager\n(receiver + invoker)" {
    + Process()
  }

  IGameCommand <|.. PushStateCommand
  IGameCommand <|.. PopStateCommand
  IGameCommand <|.. ChangeStateCommand
  GameState_ o-- IGameCommand : queues
  StateManager_ ..> IGameCommand : executes after Process()
  IGameCommand ..> StateManager_ : acts on
}

note bottom of IGameCommand
  Why deferred: a screen calling
  ChangeState directly would destroy
  itself while its own method is still
  on the call stack. The queue is
  drained only when no screen method
  is executing.
end note

package "Pipeline 2 — player input" {
  interface IPlayerCommand {
    + {abstract} Execute(Player&)
  }
  class MoveLeftCommand
  class MoveRightCommand
  class StopLeftCommand
  class StopRightCommand
  class JumpCommand
  class CrouchCommand
  class StopCrouchCommand
  class AttackCommand
  class UseSkillCommand {
    - string skillName
  }
  class InteractCommand
  class ClimbCommand
  class DropThroughCommand

  class InputHandler as "InputHandler\n(invoker)" {
    - map<int, vector<KeyBinding>> keyBindings_
    + bindKey(int key, unique_ptr<IPlayerCommand>, InputType)
    + handleInput() : vector<IPlayerCommand*>
  }
  class Player_ as "Player\n(receiver)" {
    + onMoveLeft() / onJump() / onAttack()
    + useSkill(string)
    + interactWithOverlapping()
  }
  class SettingsManager_ as "SettingsManager\n(supplies key codes)"

  IPlayerCommand <|.. MoveLeftCommand
  IPlayerCommand <|.. MoveRightCommand
  IPlayerCommand <|.. StopLeftCommand
  IPlayerCommand <|.. StopRightCommand
  IPlayerCommand <|.. JumpCommand
  IPlayerCommand <|.. CrouchCommand
  IPlayerCommand <|.. StopCrouchCommand
  IPlayerCommand <|.. AttackCommand
  IPlayerCommand <|.. UseSkillCommand
  IPlayerCommand <|.. InteractCommand
  IPlayerCommand <|.. ClimbCommand
  IPlayerCommand <|.. DropThroughCommand

  InputHandler o-- IPlayerCommand : owns bindings
  IPlayerCommand ..> Player_ : acts on
  SettingsManager_ ..> InputHandler : key codes
}

note bottom of IPlayerCommand
  UseSkillCommand carries the skill name
  as a member. That parameter is why a
  command OBJECT is needed rather than
  a function pointer, and it is what
  makes both rebinding and a second
  player fall out for free.
end note

@enduml
